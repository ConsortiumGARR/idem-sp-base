<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Skeleton con Bootstrap</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="idpselect.css" />
    <style>
        .uk-text-warning {
            color: #ffad45
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #2b3145;
        }

        .footer {
            background-color: #2b3145;
        }

        #idpSelect {
            text-align: center;
            padding: 20px;
            background-color: #f8f8f8;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        #idpSelectIdPSelector {
            width: 389px;
            text-align: left;
            padding: 10px;
            background-color: transparent;
            border: none;
        }

        a.IdPSelectHelpButton {
            display: none;
        }

        div.IdPSelectPreferredIdPButton:not(:empty) {
            padding-bottom: 20px;
        }

        div.IdPSelectPreferredIdPButton:empty {
            padding-bottom: 0;
        }

        div.IdPSelectTextDiv {
            height: auto;
            /* Add some height to separate the text from the boxes */
            font-size: inherit;
            clear: inherit;
        }
    </style>
</head>

<body>
    <!-- Header / Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark footer">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link active" href="https://{{ .Env.SERVER_NAME }}/">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                            data-bs-toggle="dropdown">
                            Useful Links
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <li><a class="dropdown-item"
                                    href="https://github.com/ConsortiumGARR/idem-tutorials/tree/master/idem-fedops/HOWTO-Shibboleth">HowTo
                                    - Shibboleth</a></li>
                            <li><a class="dropdown-item" href="https://mdx.idem.garr.it/en/">IDEM MDX</a></li>
                            <li><a class="dropdown-item" href="https://registry.idem.garr.it/rr3/">IDEM Registry</a>
                            </li>
                            <li><a class="dropdown-item"
                                    href="https://wiki.idem.garr.it/wiki/Profilo_Tecnico_Operativo">Profilo Tecnico
                                    Operativo (PTO)</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!-- Main / Contenuto principale -->
    <main class="container my-4">
        <h1 class="uk-text-warning">Welcome to SP DEMO!</h1>
        <p class="fs-4">
            This is a test Service Provider designed for IdP administrators to verify attribute release within the IDEM
            Test federations.
            It displays a summary HTML page showing the attributes sent by the IdP in the current session.
        </p>
        <p class="fs-4">
            Please note: this service is intended for participants of the IDEM Test federations only.
        </p>
        <div class="container mt-5 d-flex justify-content-center">
            <div class="card shadow-lg p-4 mb-3 rounded-4" style="max-width: 500px; background: #f8f9fa;">
                <div class="card-body">
                    <!-- Titolo -->
                    <h4 class="mb-3 fw-bold text-center uk-text-warning">Access to the service</h4>
                    <div id="idpSelect"></div>
                    <script src="idpselect_config.js" type="text/javascript" language="javascript"></script>
                    <script src="idpselect.js" type="text/javascript" language="javascript"></script>
                    <noscript>
                        Your Browser does not support javascript. Please use
                        <a
                            href="http://federation.org/DS/DS?entityID=https%3A%2F%2FyourentityId.edu.edu%2Fshibboleth&return=https%3A%2F%2Fyourreturn.edu%2FShibboleth.sso%2FDS%3FSAMLDS%3D1%26target%3Dhttps%3A%2F%2Fyourreturn.edu%2F">this
                            link</a>.
                    </noscript>
                </div>
            </div>
        </div>
        <!-- Privacy Policy -->
        <div class="mt-5">
            <p class="fs-4">See the <a href="https://{{ .Env.SERVER_NAME }}/privacy.html">Privacy
                    Statement</a> for the service.</p>
            <p class="fs-4">
                Need assistance? Contact us:
                <a href="mailto:idem-help@garr.it">idem-help@garr.it</a>
            </p>
        </div>
        </div>
        </div>
        </div>
    </main>

    <!-- Loghi e Contatti -->
    <footer class="footer mt-auto text-white">
        <div class="container">
            {{ if or (eq .Env.FEDERATION_TYPE "IDEM and eduGAIN") (eq .Env.FEDERATION_TYPE "IDEM Test") }}
            <div class="row align-items-center">
                <!-- Immagine a sinistra -->
                <div class="col-md-4 text-center text-md-start">
                    <a href="https://www.garr.it/it/">
                        <img src="/assets/organization_white.png" class="img-fluid" style="max-height: 50px;">
                    </a>
                </div>

                {{ if eq .Env.FEDERATION_TYPE "IDEM and eduGAIN" }}
                <div class="col-md-4 text-center" id="edugain-logo-container">
                    <a href="https://edugain.org/">
                        <img id="edugain-logo" src="/assets/edugain_white.png" class="img-fluid"
                            style="max-height: 150px;">
                    </a>
                </div>
                {{ else if eq .Env.FEDERATION_TYPE "IDEM Test" }}
                <div class="col-md-4 text-center">
                </div>
                {{ end }}

                <!-- Immagine a destra -->
                <div class="col-md-4 text-center text-md-end">
                    <a href="https://www.idem.garr.it/">
                        <img src="/assets/idem_white.png" class="img-fluid" style="max-height: 50px;">
                    </a>
                </div>
            </div>
            {{ end }}
        </div>
    </footer>
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>