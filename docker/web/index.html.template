<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IDEM SP Demo</title>
	
  <!-- Link al CSS di Bootstrap (CDN) -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
  <style>
    .navbar {
        background-color: #000;
    }
    .navbar-brand, .nav-link {
        color: white !important;
    }
    .wrapper {
        min-height: 95vh;
        display: flex;
        flex-direction: column;
    }
    .content {
        flex: 1;
    }
    .footer {
        background-color: #adb5bd;
        width: 100%;
        padding: 20px 0;
    }
  </style>
</head>

<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark">
      <div class="container">
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
              <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="navbarNav">
              <ul class="navbar-nav ml-auto">
                  <li class="nav-item">
                      <a class="nav-link" href="https://{{ .Env.SERVER_NAME }}/">Home</a>
                  </li>
                  <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                        Useful Links
                    </a>
                    <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                        <li><a class="dropdown-item" href="https://github.com/ConsortiumGARR/idem-tutorials/tree/master/idem-fedops/HOWTO-Shibboleth">HowTo - Shibboleth</a></li>
                        <li><a class="dropdown-item" href="https://mdx.idem.garr.it/en/">IDEM MDX</a></li>
                        <li><a class="dropdown-item" href="https://registry.idem.garr.it/rr3/">IDEM Registry</a></li>
                        <li><a class="dropdown-item" href="https://wiki.idem.garr.it/wiki/Profilo_Tecnico_Operativo">Profilo Tecnico Operativo (PTO)</a></li>
                    </ul>
                </li>
              </ul>
          </div>
      </div>
  </nav>

  <!-- Contenitore principale con Bootstrap -->
  <div class="wrapper">
    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-8">
        
          <!-- Testo Introduttivo -->
          <div class="mb-5">
            <h2>Welcome to SP DEMO!</h2>
            <br>
            <p class="text-start">
              This is a test Service Provider designed for IdP administrators to verify attribute release within the {{ .Env.FEDERATION_TYPE}} federations.
              It displays a summary HTML page showing the attributes sent by the IdP in the current session.
            </p>
            <p class="text-start">
              Please note: this service is intended for participants of the {{ .Env.FEDERATION_TYPE}} federations only.
            </p>
          </div>

          <!-- Card DS -->
          <div class="container mt-5 d-flex justify-content-center">
            <div class="card shadow-lg p-4 mb-3 rounded-4" style="max-width: 500px; background: #f8f9fa;">
              <div class="card-body">
                <!-- Titolo -->
                <h4 class="mb-3 fw-bold text-center">Select Login Type</h4>

                <!-- Testo -->
                <p class="text-muted">
                  To test the desired IdPs select the login methodology by pressing the appropriate button below.
                </p>
                <p class="text-muted">
                  Only IdPs that support <strong>Multi-Factor Authentication (MFA)</strong> will be selectable for the MFA login option.
                </p>

                <!-- Pulsanti -->
                <div class="text-center d-grid gap-3 mt-4">
                  <button class="btn btn-primary btn-lg shadow-sm" onclick="window.location.href='https://{{ .Env.SERVER_NAME }}/secure'">
                    Login
                  </button>
                  <button class="btn btn-success btn-lg shadow-sm" onclick="window.location.href='https://{{ .Env.SERVER_NAME }}/secureMFA'">
                    Login with MFA
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Privacy Policy -->
          <div class="mt-5">
            <p class="text-start">See the <a href="https://{{ .Env.SERVER_NAME }}/shibboleth-ds/privacy.html">Privacy Statement</a> for the service.</p>
            <p class="mb-0">
              Need assistance? Contact us: 
              <a href="mailto:idem-help@garr.it">idem-help@garr.it</a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Loghi e Contatti -->
    <footer class="footer mt-auto text-white">
      <div class="container">
        <div class="row align-items-center">
        <!-- Immagine a sinistra -->
          <div class="col-md-3 text-center text-md-start">
            <a href="https://www.garr.it/it/">
              <img src="./assets/logo-garr.png" class="img-fluid" style="max-height: 50px;">
            </a>
          </div>

          <!-- Logo centrale eduGAIN -->
          <div class="col-md-6 text-center" id="edugain-logo-container">
            <a href="https://edugain.org/">
              <img id="edugain-logo" src="./assets/EduGAIN_bianco.png" class="img-fluid" style="max-height: 50px;">
            </a>
          </div>

          <!-- Immagine a destra -->
          <div class="col-md-3 text-center text-md-end">
            <a href="https://www.idem.garr.it/">
              <img src="./assets/logoIDEM_bianco.png" class="img-fluid" style="max-height: 50px;">
            </a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <!-- Aggiungi il JS di Bootstrap (CDN) -->
  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.0.7/dist/umd/popper.min.js"></script>
  <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    const FEDERATION_TYPE = "{{ .Env.FEDERATION_TYPE }}";
  
    if (FEDERATION_TYPE === "IDEM and eduGAIN") {
      document.getElementById("edugain-logo").src = "./assets/EduGAIN_bianco.png";
    } else {
      document.getElementById("edugain-logo-container").classList.add("d-none");
    }
  </script>

</body>
</html>
