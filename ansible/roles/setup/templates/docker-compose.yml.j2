services:
    idem-sp:
        image: {{ container_registry }}{{ docker_image_name }}:{{ version_idem_sp }}
        container_name: {{ fqdn }}-{{ location }}
        hostname: {{ fqdn }}
        env_file:
            - ".env"
        ports:
            - "{{ http_port }}:80"
            - "{{ https_port }}:443"
        volumes:
            - "/srv/idem-certbot:/etc/letsencrypt"
        restart: unless-stopped
        logging:
            driver: syslog
            options:
                syslog-address: "udp://{{ node_ip_priv }}:514"
                tag: "{{ '{{' }} .Name {{ '}}' }}"
