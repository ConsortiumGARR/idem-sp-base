# VARIABLES
DEPLOY_TYPE={{ deploy_type }}
HAPROXY_IP_RANGE={{ haproxy_ip_range }}

SERVER_NAME={{ fqdn }}
SERVER_ADMIN={{ server_admin }}
# Type of SP: "IDEM Test" or "IDEM and eduGAIN", default: "Example"
FEDERATION_TYPE={{ federation_type }}
# The Service Provider EntityID
ENTITY_ID={{ entity_id }}
# Passphrase used to decrypt the private key.
CERT_PASSPHRASE={{ cert_passphrase }}
# SSL certificate location
SSL_CERT_LOCATION={{ ssl_cert_location }}
CA_CERT_NAME={{ ca_cert }}

### Metadata
# If you need to connect one SP with only one IdP set the REMOTE_IDP_ENTITY_ID and the REMOTE_IDP_METADATA_URL variables.
# If you need to connect to >1 IdP, set the WAYF_URL. (e.g. for IDEM TEST Federation, WAYF_URL="https://wayf.idem-test.garr.it/WAYF")
# If you want to use the Shibboleth EDS you must set EDS_ENABLED to 'true'
REMOTE_IDP_ENTITY_ID={{ remote_idp_entity_id }}
REMOTE_IDP_METADATA_URL={{ remote_idp_entity_id }}

WAYF_URL={{ wayf_url }}

EDS_ENABLED={{ eds_enabled }}

# To use MDX, set the MDX_FED_TYPE variable. Possible values: idem-test, idem, edugain.
MDX_FED_TYPE={{ mdx_fed_type }}
